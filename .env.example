SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Exclusivamente backend. Nunca usar prefijo VITE_ para esta clave.
SUPABASE_SECRET_KEY=
PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
# 0 local; 1 para el único proxy de Render. Revisar si se añade otro proxy/CDN.
TRUST_PROXY_HOPS=0
# Backend only: 32 random bytes encoded as 64 hex characters. Keep a secure backup.
# Required for new attachment uploads/downloads; never prefix with VITE_.
# ATTACHMENT_ENCRYPTION_KEY=

# Fase 5: backend only; retain V1 to read existing encrypted attachments.
# ATTACHMENT_ENCRYPTION_KEY_V1=
ATTACHMENT_ENCRYPTION_ACTIVE_VERSION=V1
# ATTACHMENT_ENCRYPTION_KEY_V2=
